PORT=4000

# PostgreSQL (must have the PostGIS extension available - see backend/README.md
# for how to get this on Railway specifically)
DATABASE_URL=postgres://tsvaga:tsvaga@localhost:5432/tsvaga

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Web Push (generate with: npm run generate:vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:you@example.com

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173
